<?xml version="1.0" encoding="utf-8"?>
<!-- Action bar button: a rounded rectangle, not a stadium. At 34dp tall the
     22dp radius of bg_button turned every label into a pill; 10dp reads as a
     button that belongs to the card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
