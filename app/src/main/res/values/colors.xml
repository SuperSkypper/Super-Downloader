<?xml version="1.0" encoding="utf-8"?>
<!--
  Single palette for the app: one place to change the theme.

  Dark by decision. `Theme.SuperDownloader` derives from Material3.Dark, so
  DayNight never enters light mode. The look follows Super Capture, the
  UI reference for this user's apps.
-->
<resources>
    <!-- Window and page background -->
    <color name="bg">#0B0D10</color>
    <color name="surface">#14181F</color>
    <color name="surface_variant">#1C222B</color>
    <color name="border">#2A323D</color>

    <!-- Text -->
    <color name="text">#E6EDF3</color>
    <color name="text_muted">#8B98A8</color>

    <!-- Accent and states -->
    <color name="accent">#58A6FF</color>
    <color name="accent_dim">#1F3A5F</color>
    <color name="danger">#F85149</color>

    <!-- Neutral actions -->
    <color name="on_accent">#08121F</color>
</resources>